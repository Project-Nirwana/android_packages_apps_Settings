<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_header_top"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"
                android:textColor="?android:attr/colorAccent"
                android:textStyle="bold"
                android:text="@string/nirwana_about_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/nirwana_device_title" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nirwana_about_device_subtitle"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/banner_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_card_top_hero"
        app:cardCornerRadius="@dimen/radius_hero"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/banner_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nirwana_gurez_header"
                android:importantForAccessibility="no"
                app:layout_constraintDimensionRatio="32:11"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="38dp"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nirwana_banner_title_part1"
                    android:textColor="?android:attr/colorAccent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:text="@string/nirwana_banner_title_part2"
                    android:textColor="@android:color/white"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:background="@drawable/circle_bg"
                android:paddingHorizontal="@dimen/padding_pill_horizontal"
                android:paddingVertical="@dimen/padding_pill_vertical"
                android:text="@string/nirwana_kashmera_tag"
                android:textColor="?android:attr/colorAccent"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_standard">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_vertical_split"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.425" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/clock_card_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="20dp"
            app:cardCornerRadius="@dimen/radius_small"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:layout_constraintDimensionRatio="1:2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline_vertical_split"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/clock_card_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <TextClock
                    android:id="@+id/lockscreen_clock_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:lineSpacingExtra="-8dp"
                    android:format12Hour="hh&#10;mm"
                    android:format24Hour="HH&#10;mm"
                    android:textColor="@android:color/white"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:shadowColor="#B3000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="10" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/guideline_vertical_split"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/clock_card_container"
            app:layout_constraintBottom_toBottomOf="@id/clock_card_container">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/top_group_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/settingslib_materialColorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/radius_small"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/click_device_model"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="20dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_phone"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/device_model_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Poco X5 Pro 5G"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/device_code_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="redwood"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="?android:attr/colorBackground" />

                    <LinearLayout
                        android:id="@+id/click_android_version"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="20dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_android"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/android_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Android 16"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/android_code_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="UpsideDownCake"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottom_group_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/settingslib_materialColorSurfaceContainerHighest"
                app:cardCornerRadius="@dimen/radius_small"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/click_nirwana_version"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="24dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_android"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/nirwana_version"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/nirwana_version_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Kashmera"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="?android:attr/colorBackgroundFloating" />

                    <LinearLayout
                        android:id="@+id/click_maintainer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="24dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_maintainer"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device_maintainer"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/device_maintainer_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Priyank"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceContainerHighest"
            app:cardCornerRadius="@dimen/radius_standard"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="320:178">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/hw_divider_vertical"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:background="?android:attr/colorBackgroundFloating"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/hw_divider_horizontal"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="?android:attr/colorBackgroundFloating"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:id="@+id/click_processor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/hw_divider_horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/hw_divider_vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_processor"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/processor_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/processor_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Qualcomm 778G"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/click_camera"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/hw_divider_horizontal"
                    app:layout_constraintStart_toEndOf="@id/hw_divider_vertical"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_camera"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/camera_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/camera_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="108 MP + 8 MP + 5 MP"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/click_storage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/hw_divider_horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/hw_divider_vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_storage"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/storage_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/storage_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="256 GB"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/click_screen"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/hw_divider_horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/hw_divider_vertical"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_screen"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/screen_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/screen_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="6.7 OLED"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>