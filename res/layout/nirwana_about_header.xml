<?xml version="1.0" encoding="utf-8"?>
<!-- packages/apps/Settings/res/layout/nirwana_about_header.xml -->
<!-- Patched for AOSP Compliance: Added IDs, Accessibility ignores, and Text Shadows -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_header_top"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"
                android:textColor="?android:attr/colorAccent"
                android:textStyle="bold"
                android:text="@string/nirwana_about_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/nirwana_device_title" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nirwana_about_device_subtitle"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Banner Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/banner_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_banner"
        android:layout_marginStart="@dimen/margin_standard"
        android:layout_marginTop="@dimen/margin_card_top_hero"
        android:layout_marginEnd="@dimen/margin_standard"
        app:cardCornerRadius="@dimen/radius_hero"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- PATCH: Added importantForAccessibility -->
            <ImageView
                android:id="@+id/banner_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="38dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nirwana_banner_title_part1"
                    android:textColor="?android:attr/colorAccent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- PATCH: Added shadow for legibility over dynamic banner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:text="@string/nirwana_banner_title_part2"
                    android:textColor="@android:color/white"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/circle_bg"
                    android:paddingHorizontal="@dimen/padding_pill_horizontal"
                    android:paddingVertical="@dimen/padding_pill_vertical"
                    android:text="@string/nirwana_kashmera_tag"
                    android:textColor="?android:attr/colorAccent"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Grid Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_standard"
        android:layout_marginTop="@dimen/margin_standard"
        android:layout_marginEnd="@dimen/margin_standard"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/height_hero_grid"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius_small"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- PATCH: Added importantForAccessibility -->
                <ImageView
                    android:id="@+id/clock_card_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <!-- PATCH: Added heavy text shadow for light wallpapers -->
                <TextClock
                    android:id="@+id/lockscreen_clock_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:lineSpacingExtra="-10dp"
                    android:format12Hour="hh&#10;mm"
                    android:format24Hour="HH&#10;mm"
                    android:textColor="@android:color/white"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:shadowColor="#B3000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="10" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/height_hero_grid"
            android:layout_marginStart="@dimen/margin_gap_hero"
            android:layout_weight="1.6"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
                app:cardCornerRadius="@dimen/radius_small"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- PATCH: ID click_device_model -->
                    <LinearLayout
                        android:id="@+id/click_device_model"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="24dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_phone"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/device_model_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Poco X5 Pro 5G"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/device_code_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="redwood"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_between_rows"
                        android:background="?android:attr/colorBackground" />

                    <!-- PATCH: ID click_android_version -->
                    <LinearLayout
                        android:id="@+id/click_android_version"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="24dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_android"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/android_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Android 16"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/android_code_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="UpsideDownCake"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_between_rows" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
                app:cardCornerRadius="@dimen/radius_small"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- PATCH: ID click_nirwana_version -->
                    <LinearLayout
                        android:id="@+id/click_nirwana_version"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="24dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_android"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/nirwana_version"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/nirwana_version_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Kashmera"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_between_rows"
                        android:background="?android:attr/colorBackground" />

                    <!-- PATCH: Added ID click_maintainer -->
                    <LinearLayout
                        android:id="@+id/click_maintainer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="24dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="@dimen/size_icon_standard"
                            android:layout_height="@dimen/size_icon_standard"
                            android:src="@drawable/ic_maintainer"
                            android:tint="?android:attr/colorAccent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device_maintainer"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/device_maintainer_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Priyank"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Hardware Info Grid -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_hw_info_total"
        android:layout_marginStart="@dimen/margin_standard"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="@dimen/margin_standard"
        app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
        app:cardCornerRadius="@dimen/radius_standard"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- PATCH: Added ID click_processor -->
                <LinearLayout
                    android:id="@+id/click_processor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_processor"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/processor_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/processor_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Qualcomm"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/margin_between_rows"
                    android:layout_height="match_parent"
                    android:background="?android:attr/colorBackground" />

                <!-- PATCH: Added ID click_camera -->
                <LinearLayout
                    android:id="@+id/click_camera"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_camera"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/camera_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/camera_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Multi-cam"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_between_rows"
                android:background="?android:attr/colorBackground" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- PATCH: Added ID click_storage -->
                <LinearLayout
                    android:id="@+id/click_storage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_storage"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/storage_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/storage_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="256 GB"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/margin_between_rows"
                    android:layout_height="match_parent"
                    android:background="?android:attr/colorBackground" />

                <!-- PATCH: Added ID click_screen -->
                <LinearLayout
                    android:id="@+id/click_screen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_icon_standard"
                        android:layout_height="@dimen/size_icon_standard"
                        android:src="@drawable/ic_screen"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screen_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/screen_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="FHD+"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>